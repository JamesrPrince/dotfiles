#!/bin/bash
# SketchyBar config, paired with AeroSpace (~/.aerospace.toml)
# Styled after FelixKratz/dotfiles (e6288b3), with yabai swapped for AeroSpace

export PATH="/usr/local/bin:$PATH"

source "$HOME/.config/sketchybar/colors.sh"
source "$HOME/.config/sketchybar/icons.sh"

ITEM_DIR="$HOME/.config/sketchybar/items"
PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# A fresh bar starts out of zen mode, and redraws the workspaces from scratch
rm -f "${TMPDIR:-/tmp}/sketchybar_zen" "${TMPDIR:-/tmp}/sketchybar_spaces_state"

FONT="SF Pro" # Needs Regular, Bold, Semibold, Heavy and Black
TEXT_FONT="Nunito" # labels and text; glyph icons stay on SF Pro (SF Symbols)
PADDINGS=3

bar=(
  height=39
  color=$BAR_COLOR
  shadow=on
  position=top
  sticky=on
  topmost=window
  padding_right=10
  padding_left=10
  corner_radius=9
  y_offset=10
  margin=10
  blur_radius=20
  notch_width=0
)

sketchybar --bar "${bar[@]}"

defaults=(
  updates=when_shown
  icon.font="$FONT:Bold:14.0"
  icon.color=$ICON_COLOR
  icon.padding_left=$PADDINGS
  icon.padding_right=$PADDINGS
  label.font="$TEXT_FONT:SemiBold:13.0"
  label.color=$LABEL_COLOR
  label.padding_left=$PADDINGS
  label.padding_right=$PADDINGS
  padding_right=$PADDINGS
  padding_left=$PADDINGS
  background.height=30
  background.corner_radius=9
  popup.background.border_width=2
  popup.background.corner_radius=9
  popup.background.border_color=$POPUP_BORDER_COLOR
  popup.background.color=$POPUP_BACKGROUND_COLOR
  popup.blur_radius=20
  popup.background.shadow.drawing=on
)

sketchybar --default "${defaults[@]}"

# Left
source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/mode.sh"
source "$ITEM_DIR/layout.sh"
source "$ITEM_DIR/front_app.sh"

# Center
source "$ITEM_DIR/spotify.sh"

# Right, listed right to left
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/next_event.sh"
source "$ITEM_DIR/weather.sh"
source "$ITEM_DIR/timer.sh"
source "$ITEM_DIR/privacy.sh"
source "$ITEM_DIR/notifications.sh"
source "$ITEM_DIR/control.sh"
source "$ITEM_DIR/keys.sh"
source "$ITEM_DIR/wifi.sh"
source "$ITEM_DIR/vpn.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/disk.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/stats.sh"

# Status group: one pill around the control, keys, Wi-Fi, VPN, battery and volume items
status_bracket=(
  background.color=$BACKGROUND_1
  background.border_color=$BACKGROUND_2
  background.border_width=2
)
sketchybar --add bracket status control keys wifi vpn battery volume_icon \
           --set status "${status_bracket[@]}"

# Hover highlight on everything you can click. Items with a plugin handle it
# there (plugins/hover.sh is sourced first); the rest use hover.sh directly.
for item in apple.logo badge.slack badge.whatsapp badge.telegram badge.outlook keys \
            mem gpu volume_icon; do
  sketchybar --set $item script="$PLUGIN_DIR/hover.sh"
done
for item in apple.logo calendar weather timer github badge.slack badge.whatsapp \
            badge.telegram badge.outlook control keys wifi disk volume_icon \
            cpu.percent mem gpu; do
  sketchybar --subscribe $item mouse.entered mouse.exited
done

# Window border follows the theme accent (updates a running JankyBorders)
pgrep -xq borders && "$PLUGIN_DIR/theme.sh" borders
# Ghostty follows the bar theme (rewrites its theme file only when it changes)
"$PLUGIN_DIR/theme.sh" ghostty

sketchybar --update
