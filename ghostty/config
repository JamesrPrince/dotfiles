# Ghostty Configuration — optimized for yazi + general use

# --- Font ---
font-size = 13
font-family = "MesloLGS NF"          # Powerlevel10k's recommended font; already on your system

# --- Window ---
window-padding-x = 8
window-padding-y = 8
window-decoration = true

# --- Colors & Theme ---
# ctrl+` quick terminal shares this palette; Ghostty has no per-surface theme.
# macos-titlebar-style=transparent otherwise derives window-theme from background
# luminosity, which kept the popup on Gruvbox Light (#fbf1c7).
window-theme = dark
# Fallback only: theme.conf (written by the bar's ⌥⇧T theme switcher, not in
# git) loads after this file and sets the theme to match the bar.
theme = Gruvbox Dark
config-file = ?theme.conf
# 1 is solid; lower shows more of what is behind. Needs a full Ghostty restart (Cmd+Q, reopen).
background-opacity = 0.9
background-blur = true

# --- Cursor ---
cursor-style = block
cursor-style-blink = false

# --- Shell Integration ---
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# --- Notifications ---
# Needs shell integration (zsh above) so Ghostty sees command start and end.
# Desktop notification when a command runs 10s or longer while Ghostty is not the active app.
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s

# --- Input / session ---
# Left Option acts as Alt; right Option keeps typing special characters.
macos-option-as-alt = left
# Always restore windows, tabs and splits on next launch.
window-save-state = always

# --- Image Protocol (critical for yazi previews) ---
# Ghostty supports the Kitty Graphics Protocol natively — yazi auto-detects this.
# No extra config needed; just ensure this file is present so Ghostty loads cleanly.

# --- Scrollback ---
scrollback-limit = 10000

# --- Performance ---
resize-overlay = never

# --- Keybindings ---
# Open a new split with Cmd+D (horizontal) and Cmd+Shift+D (vertical)
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
# Navigate splits with Cmd+Opt+Arrows
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:up
keybind = cmd+opt+down=goto_split:down
# Zoom the focused split to fill the window (same key again to restore)
keybind = cmd+shift+enter=toggle_split_zoom
# Make all splits equal size
keybind = cmd+ctrl+equal=equalize_splits
# Jump between shell prompts (needs shell integration)
keybind = cmd+shift+up=jump_to_prompt:-1
keybind = cmd+shift+down=jump_to_prompt:1

# --- Drop-down terminal (quick terminal) ---
# Ctrl+` from any app slides a terminal down from the top, centred left to right; it hides when it loses focus.
# Global keys need Ghostty in System Settings > Privacy & Security > Accessibility.
# Position changes need a full Ghostty restart (Cmd+Q, reopen).
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
# Height, then width (a width under 100% sits centred)
quick-terminal-size = 45%,50%
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15
