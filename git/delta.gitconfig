# delta as git's pager: side-by-side, syntax-highlighted diffs.
# Included from ~/.gitconfig (which stays out of this repo: it holds the email address).
# syntax-theme ansi follows the terminal colours, like bat, so it tracks the theme engine.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = ansi
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
