{
  "name": "gruvbox-bar",
  "description": "Minimal Gruvbox top bar: workspaces, clock, battery, wifi.",
  "tags": ["bar", "gruvbox"],
  "htmlPath": "bar.html",
  "defaultPlacements": [
    {
      "anchor": "top_center",
      "offsetX": "0",
      "offsetY": "0",
      "width": "100%",
      "height": "32px",
      "monitorSelection": "all",
      "dockToEdge": { "enabled": true, "edge": "top", "windowMargin": "0px" }
    }
  ],
  "privileged": false,
  "focused": false,
  "shownInTaskbar": false,
  "alwaysOnTop": false,
  "resizable": false,
  "transparent": true
}
