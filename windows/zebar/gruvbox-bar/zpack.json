{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/zpack-schema.json",
  "name": "gruvbox-bar",
  "version": "2.0.0",
  "description": "The Mac's flat SketchyBar in gruvbox: workspaces with app icons, window title, clock, markets, stats, tray.",
  "tags": ["bar", "gruvbox", "flat"],
  "widgets": [
    {
      "name": "gruvbox-bar",
      "htmlPath": "bar.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["**/*"],
      "privileges": {
        "shellCommands": [
          {
            "program": "curl",
            "argsRegex": "^-s -m 8 -A dotfiles-bar https://(api\\.exchange\\.coinbase\\.com/products/BTC-USD/stats|api\\.gold-api\\.com/price/XAU|query2\\.finance\\.yahoo\\.com/v8/finance/chart/GC=F\\?interval=1d&range=2d)$"
          },
          { "program": "explorer", "argsRegex": "^ms-(settings|availablenetworks|actioncenter):[A-Za-z0-9/&=:-]*$" },
          { "program": "taskmgr", "argsRegex": "^$" }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "28px",
          "monitorSelection": { "type": "all" },
          "dockToEdge": { "enabled": true, "edge": "top", "windowMargin": "0px" }
        }
      ]
    }
  ]
}
